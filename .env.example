# Copy this file to `.env` and adjust values as needed.

# Psyche LLM service (psyche_ollama.py listens on PSYCHE_PORT; 5001 avoids the macOS AirPlay port 5000)
PSYCHE_LLM_API_URL=http://127.0.0.1:5001/
PSYCHE_PORT=5001
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_RETRIES=2
# Thinking models (qwen3, deepseek-r1) are far slower with thinking on
OLLAMA_THINK=0
OLLAMA_MAX_TOKENS=512
OLLAMA_TIMEOUT=120
# Context window per request (prompts need ~2k tokens; smaller = less memory)
OLLAMA_NUM_CTX=4096

# Logging and pacing
# .jsonl (one JSON object per cycle) or legacy .csv
LOG_FILE=adam_behavior_log.jsonl
CYCLE_SLEEP=5
IMAGINE_TOP_K=3
# Ask the LLM to imagine each option's outcome (live runs; benchmark.py skips it unless --imagine)
IMAGINE_WITH_LLM=1
# One LLM call per cycle instead of two (faster, less deliberate)
SINGLE_CALL=0
# Store each cycle's exact prompts and raw LLM replies in the JSONL log (large)
TRACE_PROMPTS=0
TOM_INTERVAL=5
LOG_LEVEL=INFO
PSYCHE_TIMEOUT=30
PSYCHE_RETRIES=2
PSYCHE_BACKOFF=0.5
MEMORY_UPSERT_BATCH=5

# Agent initialization (simple keys)
AGENT_MOOD=neutral
AGENT_LEVEL=0.1
AGENT_CURIOSITY=0.8
AGENT_BRAVERY=0.6
AGENT_CAUTION=0.7
AGENT_HUNGER=0.1
AGENT_FATIGUE=0.2
AGENT_LONELINESS=0.2
# Leave empty to let Adam propose his own goals from his needs
AGENT_GOAL=

# Agent initialization (full JSON override; uncomment to use)
# AGENT_STATUS_JSON={"emotional_state":{"mood":"anxious","level":0.4},"personality":{"curiosity":0.7,"bravery":0.4,"caution":0.8},"needs":{"hunger":0.15},"goal":"Calm the environment and rest."}

# Long-term memory: chroma (local, default), pinecone, or none
MEMORY_BACKEND=chroma
SENTENCE_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./chroma

# Pinecone (only when MEMORY_BACKEND=pinecone)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=project-adam-memory-text

# Security harness (experimental; see adamsec/README.md)
ADAMSEC_ENABLED=0
# ADAMSEC_PLAYBOOK=perception_conflict
